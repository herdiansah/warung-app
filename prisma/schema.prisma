generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Store {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())

  users        User[]
  products     Product[]
  transactions Transaction[]
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("cashier") // owner, manager, cashier
  store_id      String?
  store         Store?   @relation(fields: [store_id], references: [id])
  created_at    DateTime @default(now())

  transactions  Transaction[]
  cash_movements CashMovement[]
}

model Setting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt
}

model Product {
  id             String            @id @default(uuid())
  name           String
  category       String?
  purchase_price Decimal
  selling_price  Decimal
  stock          Int               @default(0)
  unit           String
  is_active      Boolean           @default(true)
  store_id       String?
  store          Store?            @relation(fields: [store_id], references: [id])
  created_at     DateTime          @default(now())
  transactionItems TransactionItem[]
  stockLogs        StockLog[]
  
  @@index([name])
}

model Customer {
  id         String   @id @default(uuid())
  name       String
  phone      String?
  address    String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  transactions Transaction[]
  payments     CustomerPayment[]

  @@index([name])
}

model CustomerPayment {
  id          String    @id @default(uuid())
  customer_id String
  customer    Customer  @relation(fields: [customer_id], references: [id])
  amount      Decimal
  note        String?
  created_by  String
  created_at  DateTime  @default(now())

  @@index([customer_id])
}

model CashMovement {
  id         String   @id @default(uuid())
  type       String   // in | out
  category   String   // modal, pribadi, sewa, listrik, kulakan_lain, lain
  amount     Decimal
  note       String?
  moved_at   DateTime @default(now())
  created_by String
  user       User     @relation(fields: [created_by], references: [id])

  @@index([moved_at])
}

model Transaction {
  id               String            @id @default(uuid())
  transaction_date DateTime          @default(now())
  total_amount     Decimal
  created_by       String
  idempotency_key  String?           @unique
  status           String            @default("completed") // completed, void
  void_reason      String?
  voided_by        String?
  payment_method   String            @default("cash") // cash, credit
  customer_id      String?
  customer         Customer?         @relation(fields: [customer_id], references: [id])
  store_id         String?
  store            Store?            @relation(fields: [store_id], references: [id])
  user             User              @relation(fields: [created_by], references: [id])
  created_at       DateTime          @default(now())
  items            TransactionItem[]

  @@index([transaction_date])
}

model TransactionItem {
  id             String      @id @default(uuid())
  transaction_id String
  transaction    Transaction @relation(fields: [transaction_id], references: [id])
  product_id     String
  product        Product     @relation(fields: [product_id], references: [id])
  product_name   String
  qty            Int
  price          Decimal
  unit_cost      Decimal
  subtotal       Decimal

  @@index([product_id])
}

model StockLog {
  id           String    @id @default(uuid())
  product_id   String
  product      Product   @relation(fields: [product_id], references: [id])
  change_type  String
  qty          Int
  stock_before Int
  stock_after  Int
  actor        String?
  reason       String?
  reference_id String?
  created_at   DateTime  @default(now())
}
