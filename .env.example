# Required application configuration
DATABASE_URL="mysql://<database-user>:<database-password>@127.0.0.1:3306/<database-name>"
JWT_SECRET="<generate-a-random-secret-of-at-least-32-characters>"

# Server defaults to loopback; expose publicly through a reverse proxy.
HOST="127.0.0.1"
PORT="3000"

# Required only when running the seed command.
ADMIN_NAME="Owner"
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="<use-a-unique-password-of-at-least-12-characters>"
