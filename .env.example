# Required application configuration
DATABASE_URL="mysql://<database-user>:***@127.0.0.1:3306/<database-name>"
JWT_SECRET="<generate-a-random-secret-of-at-least-32-characters>"

# Server defaults to loopback; expose publicly through a reverse proxy.
HOST="127.0.0.1"
PORT="3000"

# Required only when running the seed command.
ADMIN_NAME="Owner"
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="<use-a-unique-password-of-at-least-12-characters>"

# --- Logging (optional) ---
# LOG_LEVEL: debug | info | warn | error (default: info)
# LOG_FORMAT: pretty (colored console + logs/app.log) | json (one JSON object per line on stdout)
LOG_LEVEL="info"
LOG_FORMAT="pretty"

# Error tracking integration point (optional): POSTs every ERROR-level log as
# JSON to this URL. Accepts Sentry-compatible ingest endpoints, Slack webhooks, etc.
# ERROR_WEBHOOK_URL="https://example.com/hooks/errors"
